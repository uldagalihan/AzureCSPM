# Azure CSPM - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real credentials to version control.

# Required - Azure AD app registration credentials
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Optional - if set, scripts process only this subscription.
# If unset, all accessible subscriptions are enumerated automatically.
AZURE_SUBSCRIPTION_ID=
